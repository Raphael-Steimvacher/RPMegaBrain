{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "synthetic": {
      "const": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "title",
    "description",
    "synthetic",
    "acceptance_criteria"
  ]
}
