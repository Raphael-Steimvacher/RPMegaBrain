{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "adapter": {
            "const": "filesystem"
          },
          "root_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*_ROOT$"
          },
          "access": {
            "const": "read"
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "personal",
              "confidential"
            ]
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_item_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          }
        },
        "required": [
          "id",
          "adapter",
          "root_env",
          "access",
          "sensitivity",
          "include",
          "exclude",
          "max_item_bytes"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ]
}
