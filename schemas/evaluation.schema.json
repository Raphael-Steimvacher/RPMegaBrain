{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evaluation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "accepted",
        "accepted_with_corrections",
        "rejected",
        "blocked"
      ]
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "policy_violation",
          "profile_mixing",
          "secret_leak",
          "unexecuted_test_claim",
          "invented_reference",
          "out_of_scope_change"
        ]
      },
      "uniqueItems": true
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technical_correctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "requirement_coverage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "actionability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "teaching_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "efficiency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "technical_correctness",
        "requirement_coverage",
        "actionability",
        "teaching_clarity",
        "efficiency"
      ]
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "context_missing",
              "context_irrelevant",
              "technical_error",
              "requirement_ignored",
              "invented_reference",
              "insufficient_explanation",
              "unactionable_plan",
              "policy_violation",
              "excessive_usage",
              "external_problem"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "category",
          "note"
        ]
      }
    },
    "user_notes": {
      "type": "string",
      "maxLength": 100000
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "verdict",
    "hard_failures",
    "scores",
    "corrections",
    "user_notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "hard_failures": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "hard_failures"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "rejected",
              "blocked"
            ]
          }
        }
      }
    }
  ]
}
