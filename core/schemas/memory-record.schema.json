{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "v2-memory-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "memory_id": {
      "type": "string",
      "pattern": "^mem_[A-Za-z0-9-]+$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "kind": {
      "type": "string",
      "enum": [
        "decision",
        "correction",
        "preference",
        "convention",
        "verified_fact",
        "pattern"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "expired",
        "revoked",
        "quarantined"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "personal",
        "confidential"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "tentative",
        "supported",
        "confirmed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "validity_type": {
      "type": "string",
      "enum": [
        "static",
        "release_bound",
        "repository_bound",
        "time_bound",
        "task_bound"
      ]
    },
    "source_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
      },
      "uniqueItems": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_content_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
      },
      "uniqueItems": true
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "limits": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "definition",
            "plan",
            "memory"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "approved_by": {
          "const": "user"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "content_hash",
        "approved_by",
        "approved_at"
      ]
    },
    "change_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "memory_id",
    "profile_id",
    "scope_id",
    "kind",
    "subject",
    "status",
    "sensitivity",
    "confidence",
    "created_at",
    "verified_at",
    "valid_until",
    "validity_type",
    "source_run_ids",
    "evidence_refs",
    "tags",
    "revision",
    "previous_content_hash",
    "content_hash",
    "supersedes",
    "conflicts_with",
    "statement",
    "limits",
    "last_seen_at",
    "approval",
    "change_reason"
  ]
}
