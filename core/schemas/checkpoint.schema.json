{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "v2-checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^chk_[A-Za-z0-9-]+$"
    },
    "previous_checkpoint_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^chk_[A-Za-z0-9-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "turn",
        "stage",
        "named",
        "pre_compact",
        "recovery",
        "final"
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "teach",
        "implement"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "definition",
        "investigation",
        "planning",
        "implementation",
        "review",
        "verification",
        "evaluation"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "accepted_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "maxItems": 100
    },
    "open_hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "maxItems": 100
    },
    "approved_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "maxItems": 100
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved"
          ]
        },
        "content_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "status",
        "content_ref",
        "content_hash"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "plan",
              "memory"
            ]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "approved_by": {
            "const": "user"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "content_hash",
          "approved_by",
          "approved_at"
        ]
      }
    },
    "active_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "content_hash"
        ]
      },
      "maxItems": 200
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "maxItems": 100
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "maxItems": 100
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "item_id",
          "revision",
          "source_hash"
        ]
      }
    },
    "memory_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^memsnap_[a-f0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "selected_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source_id",
          "revision",
          "selected_hashes",
          "captured_at"
        ]
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "resume_optional": {
          "const": true
        }
      },
      "required": [
        "provider",
        "thread_id",
        "resume_optional"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "policies_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "skills_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "version",
        "commit",
        "policies_hash",
        "skills_hash"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "checkpoint_id",
    "previous_checkpoint_id",
    "type",
    "name",
    "task_id",
    "run_id",
    "profile_id",
    "mode",
    "stage",
    "goal",
    "accepted_requirements",
    "confirmed_facts",
    "open_hypotheses",
    "approved_decisions",
    "plan",
    "approvals",
    "active_files",
    "verifications",
    "blockers",
    "next_action",
    "context_refs",
    "memory_snapshot_id",
    "source_snapshots",
    "engine",
    "harness",
    "created_at",
    "integrity_hash"
  ]
}
